{
  "name": "trends172tech",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "ip-address": "10.3.1",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "cheerio": {
      "undici": "7.29.0"
    }
  },
  "dependencies": {
    "ip-address": "10.3.1",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "undici": "7.29.0"
  },
  "scripts": {
    "postinstall": "npm --workspace packages/db run generate",
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/web run start",
    "lint": "npm --workspace apps/web run lint",
    "typecheck": "npm --workspace apps/web run typecheck",
    "security:audit": "node scripts/security-audit.mjs",
    "security:test": "npx tsx --test apps/web/tests/mcp/*.test.ts",
    "luna:test": "npx tsx --test apps/web/tests/luna-agent/*.test.ts apps/web/tests/luna-root/*.test.ts packages/luna-runner/tests/*.test.ts",
    "control:test": "npx tsx --test apps/web/tests/control-center/*.test.ts",
    "control:bootstrap": "npm --workspace packages/db run control:bootstrap",
    "luna:runner:build": "npm --workspace packages/luna-runner run build",
    "luna:runner:start": "npm --workspace packages/luna-runner run start",
    "prisma": "npm --workspace packages/db run prisma",
    "db:migrate": "npm --workspace packages/db run prisma migrate dev",
    "db:migrate:deploy": "npm --workspace packages/db run migrate:deploy",
    "db:migrate:status": "npm --workspace packages/db run prisma migrate status",
    "db:health": "npm --workspace packages/db run health",
    "db:health:http": "npm --workspace packages/db run health:http",
    "db:auth:status:http": "npm --workspace packages/db run auth:status:http",
    "db:auth:migrate:http": "npm --workspace packages/db run auth:migrate:http",
    "db:studio": "npm --workspace packages/db run prisma studio",
    "db:seed": "npm --workspace packages/db run prisma db seed",
    "db:seed-news": "npm --workspace packages/db run seed:news"
  }
}
