# Database
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/db?sslmode=require"

# Public canonical origin used by metadata, sitemap and transactional links
NEXT_PUBLIC_SITE_URL="https://www.trends172tech.com"

# Auth
AUTH_SECRET="change_me_long_random_secret"
# Dedicated key used to encrypt stored LUNA runner/provider credentials. Generate a
# distinct long random value for production and do not rotate it without a key-migration plan.
LUNA_AGENT_ENCRYPTION_KEY="change_me_long_random_secret"
ROOT_EMAIL="root@trends172tech.local"
ROOT_PASSWORD="change_me_dev_only"

# Scheduled jobs
# Required by /api/cron/bcv-rate. Configure the same value in the Vercel Cron request.
CRON_SECRET="change_me_long_random_secret"

# Protects the state-changing MCP tool endpoint at /mcp. Use a dedicated value (32+ characters).
MCP_API_SECRET="change_me_long_random_secret"

# Anthropic (Claude API)
ANTHROPIC_API_KEY="sk-ant-change_me"

# OpenAI
OPENAI_API_KEY="change_me"
OPENAI_ORG_ID=""
OPENAI_PROJECT_ID=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSION="1536"

# ChatKit (Agent Builder workflows)
CHATKIT_WORKFLOW_ID="wf_replace_me"
CHATKIT_API_BASE="https://api.openai.com"
CHATKIT_WORKFLOW_MARKETING=""
CHATKIT_WORKFLOW_SALES=""
CHATKIT_WORKFLOW_APPOINTMENTS=""
CHATKIT_WORKFLOW_SUPPORT=""
CHATKIT_WORKFLOW_PUBLIC_VOICE=""

# Human verification (Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Knowledge Base storage (optional)
KB_STORAGE_PROVIDER="local"
KB_STORAGE_PATH="C:\\kb-storage"
KB_STORAGE_S3_BUCKET=""
KB_STORAGE_S3_REGION="auto"
KB_STORAGE_S3_ENDPOINT=""
KB_STORAGE_S3_ACCESS_KEY_ID=""
KB_STORAGE_S3_SECRET_ACCESS_KEY=""

# Knowledge Base queue (Redis/BullMQ)
KB_QUEUE_REDIS_URL="redis://localhost:6379"
KB_QUEUE_NAME="knowledge-ingest"
KB_QUEUE_CONCURRENCY="2"

# Widget
NEXT_PUBLIC_WIDGET_SCRIPT_URL="https://cdn.trends172tech.com/widget.js"

# Payments (public recharge checkout button)
NEXT_PUBLIC_PAYMENT_BUTTON_URL=""
NEXT_PUBLIC_PAYMENT_AMOUNT_PARAM="amount"

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN="change_me"
WHATSAPP_ACCESS_TOKEN="change_me"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_SECRET=""

# WhatsApp lead notifications (public web agent)
WHATSAPP_LEAD_NOTIFY_TO=""
WHATSAPP_LEAD_PHONE_NUMBER_ID=""
