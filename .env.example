# Database
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/db?sslmode=require"

# Public canonical origin used by metadata, sitemap and transactional links
NEXT_PUBLIC_SITE_URL="https://www.trends172tech.com"

# Auth
AUTH_SECRET="change_me_long_random_secret"
BETTER_AUTH_SECRET="change_me_with_at_least_32_random_characters"
BETTER_AUTH_URL="http://localhost:3000"
AUTH_TRUSTED_ORIGINS="http://localhost:3000,https://trends-projects.vercel.app"
AUTH_ADMIN_EMAIL="trends172tech@gmail.com"
# Set only while running the one-time admin bootstrap command; never commit a real password.
AUTH_ADMIN_PASSWORD=""
# Public account creation remains available for the customer onboarding flow.
AUTH_DISABLE_SIGN_UP="false"

# Transactional email (Resend). The Gmail address is the recovery/reply mailbox;
# it does not require sharing the Gmail password with the application.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Trends172 Tech <seguridad@auth.trends172tech.com>"
RESEND_REPLY_TO_EMAIL="trends172tech@gmail.com"
# Dedicated key used to encrypt stored LUNA runner/provider credentials. Generate a
# distinct long random value for production and do not rotate it without a key-migration plan.
LUNA_AGENT_ENCRYPTION_KEY="change_me_long_random_secret"
ROOT_EMAIL="root@trends172tech.local"
ROOT_PASSWORD="change_me_dev_only"

# Scheduled jobs
# Required by /api/cron/bcv-rate. Configure the same value in the Vercel Cron request.
CRON_SECRET="change_me_long_random_secret"

# Engineering Studio reads Vercel only. The token must be scoped to this team.
VERCEL_STUDIO_TOKEN=""
VERCEL_STUDIO_TEAM_ID="team_DdPHfRSec41nlkwzbVIcSKAQ"

# Protects the state-changing MCP tool endpoint at /mcp. Use a dedicated value (32+ characters).
