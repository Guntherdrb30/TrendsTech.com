// DRAFT ONLY — additive Control Plane V1 schema proposal.
// This file is intentionally separate from schema.prisma so it cannot be
// applied accidentally. After review it will be merged into schema.prisma
// and receive a generated migration.

enum ControlPlaneLifecycleStatus {
  DRAFT
  TESTING
  ACTIVE
  PAUSED
  RETIRED
}

enum ControlPlaneToolProvider {
  INTERNAL
  MCP
  CONNECTOR
}

enum ControlPlaneToolRisk {
  READ
  WRITE
  SENSITIVE
  CRITICAL
}

enum ControlPlaneApprovalPolicy {
  AUTOMATIC
  POLICY
  HUMAN_REQUIRED
}

enum ControlPlaneRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

model AgentTemplateV1 {
  id           String                      @id @default(cuid())
  key          String                      @unique
  name         String
  purpose      String                      @db.Text
  lifecycle    ControlPlaneLifecycleStatus @default(DRAFT)
  capabilities Json?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  versions AgentVersionV1[]
}

model AgentVersionV1 {
  id              String   @id @default(cuid())
  templateId      String
  version         Int
  instructions    String   @db.Text
  model           String?
  modelSettings   Json?
  evaluationSuite String?
  createdAt       DateTime @default(now())

  template    AgentTemplateV1   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  deployments AgentDeploymentV1[]

  @@unique([templateId, version])
  @@index([templateId])
}

model AgentDeploymentV1 {
  id              String                      @id @default(cuid())
  tenantId        String
  agentInstanceId String
  agentVersionId  String
  name            String
  lifecycle       ControlPlaneLifecycleStatus @default(DRAFT)
  channels        String[]                    @default([])
  modelOverride   String?
  configJson      Json?
  monthlyBudgetUsd Decimal?                   @db.Decimal(12, 2)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentInstance AgentInstance   @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)
  agentVersion  AgentVersionV1  @relation(fields: [agentVersionId], references: [id])
  tools         DeploymentToolV1[]
  runs          AgentRunV1[]

  @@index([tenantId])
  @@index([agentInstanceId])
  @@index([agentVersionId])
  @@index([tenantId, lifecycle])
}

model McpServerV1 {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  endpoint    String
  owner       String?
  isActive    Boolean  @default(true)
  metadataJson Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tools ToolV1[]
}

model ToolV1 {
  id          String                      @id @default(cuid())
  key         String                      @unique
  name        String
  provider    ControlPlaneToolProvider
  risk        ControlPlaneToolRisk        @default(READ)
  approval    ControlPlaneApprovalPolicy  @default(AUTOMATIC)
  mcpServerId String?
  metadataJson Json?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  mcpServer   McpServerV1?       @relation(fields: [mcpServerId], references: [id], onDelete: SetNull)
  deployments DeploymentToolV1[]
  toolRuns    ToolRunV1[]

  @@index([mcpServerId])
  @@index([provider, risk])
}

model DeploymentToolV1 {
  id           String   @id @default(cuid())
  deploymentId String
  toolId        String
  isEnabled     Boolean  @default(true)
  policyJson    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deployment AgentDeploymentV1 @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  tool       ToolV1            @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, toolId])
  @@index([deploymentId])
  @@index([toolId])
}

model AgentRunV1 {
  id              String                @id @default(cuid())
  tenantId        String
  deploymentId    String
  agentInstanceId String
  sessionId       String
  userId          String?
  projectId       String?
  endCustomerId   String?
  channel         String
  status          ControlPlaneRunStatus @default(QUEUED)
  provider        String?
  model           String?
  inputTokens     Int?
  outputTokens    Int?
  totalTokens     Int?
  providerCostUsd Decimal?              @db.Decimal(14, 6)
  billableCostUsd Decimal?              @db.Decimal(14, 6)
  durationMs      Int?
  traceId         String?
  errorCode       String?
  errorMessage    String?               @db.Text
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deployment    AgentDeploymentV1 @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  agentInstance AgentInstance     @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)
  toolRuns      ToolRunV1[]

  @@index([tenantId, createdAt])
  @@index([deploymentId, createdAt])
  @@index([agentInstanceId, createdAt])
  @@index([sessionId])
  @@index([traceId])
}

model ToolRunV1 {
  id          String   @id @default(cuid())
  agentRunId  String
  toolId      String
  status      String
  durationMs  Int?
  inputJson   Json?
  outputMeta  Json?
  errorMessage String? @db.Text
  createdAt   DateTime @default(now())

  agentRun AgentRunV1 @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  tool     ToolV1     @relation(fields: [toolId], references: [id])

  @@index([agentRunId])
  @@index([toolId])
}
