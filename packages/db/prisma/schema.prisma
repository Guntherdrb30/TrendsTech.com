generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantMode {
  SINGLE
  RESELLER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  ROOT
  TENANT_ADMIN
  TENANT_OPERATOR
  TENANT_VIEWER
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum Language {
  ES
  EN
}

enum KnowledgeSourceType {
  URL
  PDF
  TEXT
}

enum KnowledgeSourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum InstallStatus {
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ManualPaymentCurrency {
  USD
  VES
}

enum ManualPaymentStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum RoundingRule {
  ONE
  FIVE
  TEN
}

enum WhatsAppProvider {
  META
  BSP
}

enum WhatsAppChannelStatus {
  ACTIVE
  PAUSED
}

enum NewsPostStatus {
  DRAFT
  PUBLISHED
}

enum DevExecutionMode {
  LOCAL
  REMOTE
  GITHUB
}

enum DevTaskStatus {
  PENDING
  QUEUED
  RUNNING
  REVIEW
  DONE
  FAILED
}

enum DevTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DevTaskLogLevel {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum DevTaskFileChangeType {
  CREATED
  UPDATED
  DELETED
}

enum DevAIProviderType {
  CODEX
  CLAUDE
  CUSTOM
}

enum RemoteSessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum DevQueueStatus {
  PENDING
  CLAIMED
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}

enum DevRunnerMode {
  LOCAL
  REMOTE
  GITHUB
}

enum DevRunnerStatus {
  ONLINE
  OFFLINE
  BUSY
  DISABLED
}

enum DevRunnerEventType {
  HEARTBEAT
  TASK_CLAIMED
  TASK_STARTED
  TASK_PROGRESS
  TASK_COMPLETED
  TASK_FAILED
  TASK_CANCELED
}

enum DevExecutionRuntime {
  DRY_RUN
  SHELL
  CODEX_CLI
}

enum DevUsageMetricType {
  TASKS_CREATED
  TASKS_EXECUTED
  TASKS_FAILED
  REMOTE_SESSIONS
  RUNNERS_REGISTERED
  AI_PROVIDERS_SAVED
}

enum SiteAssetSection {
  HOME_HERO
  HOME_SHOWCASE
}

model Tenant {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  mode           TenantMode       @default(SINGLE)
  status         TenantStatus     @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  users          User[]
  endCustomers   EndCustomer[]
  agentInstances AgentInstance[]
  agentAccesses  AgentAccess[]
  whatsappChannels WhatsAppChannel[]
  knowledge      KnowledgeSource[]
  installs       Install[]
  subscriptions  Subscription[]
  manualPayments ManualPayment[]
  auditLogs      AuditLog[]
  knowledgeChunks KnowledgeChunk[]
  tokenWallet    TokenWallet?
  tokenUsageLogs TokenUsageLog[]
  agentSessions  AgentSession[]
  accessLogs     AccessLog[]
  devProjects    DevProject[]
  devTasks       DevTask[]
  remoteSessions RemoteSession[]
  devRunners     DevRunner[]
  devUsageMetrics DevUsageMetric[]
}

model User {
  id                 String          @id @default(cuid())
  tenantId           String?
  email              String          @unique
  name               String?
  phone              String?
  avatarUrl          String?
  role               UserRole        @default(TENANT_VIEWER)
  passwordHash       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  tenant             Tenant?         @relation(fields: [tenantId], references: [id])
  reviewedPayments   ManualPayment[] @relation("ManualPaymentReviewedBy")
  auditLogs          AuditLog[]      @relation("AuditLogActor")
  updatedSettings    GlobalSettings[]
  updatedSiteAssets  SiteAsset[]      @relation("SiteAssetUpdatedBy")
  passwordResets     PasswordResetToken[]
  newsPosts          NewsPost[]       @relation("NewsPostAuthor")
  devProjects        DevProject[]     @relation("DevProjectCreatedBy")
  devTasks           DevTask[]        @relation("DevTaskCreatedBy")
  devAiProviders     DevAIProvider[]
  remoteSessions     RemoteSession[]
  createdDevRunners  DevRunner[]      @relation("DevRunnerCreatedBy")

  @@index([tenantId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EndCustomer {
  id             String          @id @default(cuid())
  tenantId       String
  name           String
  email          String?
  phone          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  agentInstances AgentInstance[]

  @@index([tenantId])
}

model AgentInstance {
  id              String           @id @default(cuid())
  tenantId        String
  endCustomerId   String?
  name            String
  baseAgentKey    String
  languageDefault Language         @default(ES)
  status          AgentStatus      @default(DRAFT)
  featuresJson    Json?
  brandingJson    Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  endCustomer     EndCustomer?     @relation(fields: [endCustomerId], references: [id])
  whatsappChannel WhatsAppChannel?
  knowledge       KnowledgeSource[]
  installs        Install[]
  knowledgeChunks KnowledgeChunk[]
  tokenUsageLogs  TokenUsageLog[]
  agentSessions   AgentSession[]
  accesses        AgentAccess[]
  accessLogs      AccessLog[]

  @@index([tenantId])
  @@index([endCustomerId])
  @@index([tenantId, baseAgentKey])
}

model KnowledgeSource {
  id              String               @id @default(cuid())
  tenantId        String
  agentInstanceId String
  type            KnowledgeSourceType
  title           String?
  url             String?
  fileKey         String?
  rawText         String?              @db.Text
  status          KnowledgeSourceStatus @default(PENDING)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  agentInstance   AgentInstance        @relation(fields: [agentInstanceId], references: [id])
  chunks          KnowledgeChunk[]

  @@index([tenantId])
  @@index([agentInstanceId])
}

model KnowledgeChunk {
  id              String   @id @default(cuid())
  tenantId        String
  agentInstanceId String
  sourceId        String
  content         String   @db.Text
  embedding       Unsupported("vector")
  tokenCount      Int
  metaJson        Json?
  createdAt       DateTime @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  agentInstance   AgentInstance   @relation(fields: [agentInstanceId], references: [id])
  source          KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentInstanceId])
  @@index([sourceId])
}

model Install {
  id              String        @id @default(cuid())
  tenantId        String
  agentInstanceId String
  publicKey       String        @unique
  allowedDomains  String[]      @default([])
  status          InstallStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  agentInstance   AgentInstance @relation(fields: [agentInstanceId], references: [id])

  @@index([tenantId])
  @@index([agentInstanceId])
}

model Plan {
  id               String        @id @default(cuid())
  key              String        @unique
  name_es          String
  name_en          String
  priceUsdMonthly  Decimal       @db.Decimal(12, 2)
  limitsJson       Json?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  subscriptions    Subscription[]
}

model Subscription {
  id         String             @id @default(cuid())
  tenantId   String
  planId     String
  status     SubscriptionStatus @default(ACTIVE)
  startedAt  DateTime           @default(now())
  endsAt     DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  plan       Plan               @relation(fields: [planId], references: [id])
  payments   ManualPayment[]

  @@index([tenantId])
  @@index([planId])
}

model ManualPayment {
  id               String               @id @default(cuid())
  tenantId         String
  subscriptionId   String?
  amountPaid       Decimal              @db.Decimal(12, 2)
  currencyPaid     ManualPaymentCurrency
  exchangeRateUsed Decimal?             @db.Decimal(12, 4)
  reference        String
  proofUrl         String?
  status           ManualPaymentStatus  @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant           Tenant               @relation(fields: [tenantId], references: [id])
  subscription     Subscription?        @relation(fields: [subscriptionId], references: [id])
  reviewedBy       User?                @relation("ManualPaymentReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([tenantId])
  @@index([subscriptionId])
}

model GlobalSettings {
  id                        Int          @id @default(1)
  usdToVesRate              Decimal      @db.Decimal(12, 4)
  roundingRule              RoundingRule @default(ONE)
  usdPaymentDiscountPercent Decimal      @db.Decimal(5, 2)
  tokenInputUsdPer1M        Decimal      @db.Decimal(12, 4)
  tokenOutputUsdPer1M       Decimal      @db.Decimal(12, 4)
  tokenCachedInputUsdPer1M  Decimal      @db.Decimal(12, 4)
  tokenMarkupPercent        Decimal      @db.Decimal(5, 2)
  kbUrlPageLimit            Int          @default(5)
  zelleRecipientName        String?
  zelleEmail                String?
  zellePhone                String?
  updatedByUserId           String?
  updatedAt                 DateTime     @updatedAt

  updatedBy                 User?        @relation(fields: [updatedByUserId], references: [id])

  @@index([updatedByUserId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  tenantId    String?
  action      String
  entity      String
  entityId    String
  metaJson    Json?
  createdAt   DateTime @default(now())

  actor       User     @relation("AuditLogActor", fields: [actorUserId], references: [id])
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([actorUserId])
  @@index([tenantId])
}

model WhatsAppChannel {
  id              String                @id @default(cuid())
  tenantId        String
  agentInstanceId String                @unique
  phoneNumber     String                @unique
  provider        WhatsAppProvider      @default(META)
  status          WhatsAppChannelStatus @default(ACTIVE)
  webhookSecret   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  agentInstance   AgentInstance         @relation(fields: [agentInstanceId], references: [id])

  @@index([tenantId])
}

model TokenWallet {
  tenantId  String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TokenUsageLog {
  id              String        @id @default(cuid())
  tenantId        String
  agentInstanceId String
  sessionId       String
  tokensIn        Int?
  tokensOut       Int?
  totalTokens     Int
  costUsdMicros   Int?
  billedAt        DateTime?
  model           String?
  createdAt       DateTime      @default(now())

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentInstance   AgentInstance @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentInstanceId])
  @@index([sessionId])
}

model AgentSession {
  id              String        @id @default(cuid())
  tenantId        String
  agentInstanceId String
  sessionId       String
  channel         String?
  endUserJson     Json?
  isDemo          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  lastSeenAt      DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentInstance   AgentInstance @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentInstanceId])
  @@index([sessionId])
  @@unique([tenantId, sessionId])
}

model AgentAccess {
  id                String        @id @default(cuid())
  tenantId          String
  agentId           String
  name              String
  allowedDomains    String[]      @default([])
  channel           String        @default("embedded_web")
  maxTokensPerMonth Int?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  agentInstance     AgentInstance @relation(fields: [agentId], references: [id])
  accessLogs        AccessLog[]

  @@index([tenantId])
  @@index([agentId])
  @@index([tenantId, isActive])
  @@index([agentId, isActive])
}

model AccessLog {
  id              String        @id @default(cuid())
  tenantId        String
  agentInstanceId String
  agentAccessId   String
  domain          String?
  channel         String
  event           String
  status          String
  reason          String?
  metaJson        Json?
  createdAt       DateTime      @default(now())

  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  agentInstance   AgentInstance @relation(fields: [agentInstanceId], references: [id])
  agentAccess     AgentAccess   @relation(fields: [agentAccessId], references: [id])

  @@index([tenantId])
  @@index([agentInstanceId])
  @@index([agentAccessId])
}

model NewsPost {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  summary       String         @db.Text
  body          String         @db.Text
  category      String
  language      Language       @default(ES)
  status        NewsPostStatus @default(DRAFT)
  featured      Boolean        @default(false)
  publishedAt   DateTime?
  authorUserId  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  author        User?          @relation("NewsPostAuthor", fields: [authorUserId], references: [id])

  @@index([status, language, publishedAt])
  @@index([featured, status, publishedAt])
  @@index([authorUserId])
}

model SiteAsset {
  id              String           @id @default(cuid())
  section         SiteAssetSection
  language        Language         @default(ES)
  eyebrow         String?
  badge           String?
  title           String
  body            String           @db.Text
  imageUrl        String
  blobUrl         String?
  ctaLabel        String?
  ctaHref         String?
  highlightsJson  Json?
  sortOrder       Int              @default(0)
  isActive        Boolean          @default(true)
  updatedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  updatedBy       User?            @relation("SiteAssetUpdatedBy", fields: [updatedByUserId], references: [id])

  @@index([section, language, isActive, sortOrder])
  @@index([updatedByUserId])
}

model DevProject {
  id              String           @id @default(cuid())
  tenantId        String
  createdByUserId String
  name            String
  slug            String
  repositoryUrl   String?
  localPath       String?
  defaultBranch   String?
  executionMode   DevExecutionMode @default(LOCAL)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("DevProjectCreatedBy", fields: [createdByUserId], references: [id])
  tasks           DevTask[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@index([createdByUserId])
}

model DevTask {
  id              String           @id @default(cuid())
  tenantId        String
  projectId       String
  createdByUserId String
  title           String
  description     String?          @db.Text
  status          DevTaskStatus    @default(PENDING)
  priority        DevTaskPriority  @default(MEDIUM)
  branch          String?
  executionMode   DevExecutionMode @default(LOCAL)
  aiProvider      DevAIProviderType?
  prompt          String?          @db.Text
  resultSummary   String?          @db.Text
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         DevProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("DevTaskCreatedBy", fields: [createdByUserId], references: [id])
  logs            DevTaskLog[]
  files           DevTaskFile[]
  queue           DevExecutionQueue?
  runnerEvents    DevRunnerEvent[]

  @@index([tenantId, status, createdAt])
  @@index([projectId, createdAt])
  @@index([createdByUserId])
}

model DevTaskLog {
  id         String          @id @default(cuid())
  taskId      String
  level      DevTaskLogLevel @default(INFO)
  message    String          @db.Text
  metadata   Json?
  createdAt  DateTime        @default(now())

  task       DevTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model DevTaskFile {
  id          String                @id @default(cuid())
  taskId       String
  filePath    String
  changeType  DevTaskFileChangeType
  summary     String?               @db.Text
  createdAt   DateTime              @default(now())

  task        DevTask               @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model DevAIProvider {
  id              String            @id @default(cuid())
  userId          String
  provider        DevAIProviderType
  label           String
  apiKeyEncrypted String           @db.Text
  baseUrl         String?
  isActive        Boolean          @default(true)
  isDefault       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, isDefault])
}

model RemoteSession {
  id          String              @id @default(cuid())
  tenantId    String
  userId      String
  tokenHash   String              @unique
  status      RemoteSessionStatus @default(ACTIVE)
  lastSeenAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, expiresAt])
  @@index([userId, status])
}

model DevExecutionQueue {
  id          String         @id @default(cuid())
  taskId       String         @unique
  status      DevQueueStatus @default(PENDING)
  runnerId    String?
  runtime     DevExecutionRuntime @default(DRY_RUN)
  attemptCount Int           @default(0)
  lastError   String?        @db.Text
  payloadJson Json?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  task        DevTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  runner      DevRunner?     @relation(fields: [runnerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([runnerId, status])
}

model DevRunner {
  id                 String            @id @default(cuid())
  tenantId           String
  createdByUserId    String
  name               String
  slug               String
  mode               DevRunnerMode     @default(LOCAL)
  status             DevRunnerStatus   @default(OFFLINE)
  host               String?
  machineLabel       String?
  authTokenHash      String
  lastHeartbeatAt    DateTime?
  capabilitiesJson   Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy          User              @relation("DevRunnerCreatedBy", fields: [createdByUserId], references: [id])
  queueItems         DevExecutionQueue[]
  events             DevRunnerEvent[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([createdByUserId])
}

model DevRunnerEvent {
  id          String             @id @default(cuid())
  runnerId     String
  taskId      String?
  type        DevRunnerEventType
  message     String             @db.Text
  payloadJson Json?
  createdAt   DateTime           @default(now())

  runner      DevRunner          @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  task        DevTask?           @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([runnerId, createdAt])
  @@index([taskId, createdAt])
}

model DevUsageMetric {
  id          String             @id @default(cuid())
  tenantId    String
  metricType  DevUsageMetricType
  periodMonth Int
  periodYear  Int
  value       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metricType, periodMonth, periodYear])
  @@index([tenantId, periodYear, periodMonth])
  @@index([metricType, periodYear, periodMonth])
}
